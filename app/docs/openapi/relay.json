{
  "openapi": "3.0.1",
  "info": {
    "title": "ItaRouter API reference",
    "version": "preview",
    "description": "Reference derived from the bundled New API relay specification. Endpoint documentation is not a live model-availability guarantee. Model access is being prepared."
  },
  "servers": [
    {
      "url": "https://itarouter.com",
      "description": "Public service address; inference access is being prepared."
    }
  ],
  "paths": {
    "/v1/models": {
      "get": {
        "deprecated": false,
        "operationId": "listModels",
        "tags": [
          "API reference"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                },
                "example": {
                  "object": "list",
                  "data": [
                    {
                      "id": "MODEL_ID_FROM_CATALOGUE",
                      "object": "model",
                      "created": 0,
                      "owned_by": "example-provider"
                    }
                  ]
                }
              }
            },
            "headers": {},
            "description": "Successful response."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {},
            "description": "Request could not be completed. Read the error body for details."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List models",
        "description": "List model IDs visible to your API key in the OpenAI-compatible format."
      }
    },
    "/v1/chat/completions": {
      "post": {
        "deprecated": false,
        "operationId": "createChatCompletion",
        "tags": [
          "API reference"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "example": {
                "model": "MODEL_ID_FROM_CATALOGUE",
                "messages": [
                  {
                    "role": "user",
                    "content": "Hello"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                },
                "example": {
                  "id": "chatcmpl-example",
                  "object": "chat.completion",
                  "created": 0,
                  "model": "MODEL_ID_FROM_CATALOGUE",
                  "choices": [
                    {
                      "index": 0,
                      "message": {
                        "role": "assistant",
                        "content": "Hello"
                      },
                      "finish_reason": "stop"
                    }
                  ],
                  "usage": {
                    "prompt_tokens": 5,
                    "completion_tokens": 1,
                    "total_tokens": 6
                  }
                }
              }
            },
            "headers": {},
            "description": "Successful response."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {},
            "description": "Request could not be completed. Read the error body for details."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {},
            "description": "Request could not be completed. Read the error body for details."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Chat completions",
        "description": "Generate a response from a message history. Optional parameters depend on the selected model and channel."
      }
    },
    "/v1/responses": {
      "post": {
        "deprecated": false,
        "operationId": "createResponse",
        "tags": [
          "API reference"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponsesRequest"
              },
              "example": {
                "model": "MODEL_ID_FROM_CATALOGUE",
                "input": "Hello"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponsesResponse"
                },
                "example": {
                  "id": "resp_example",
                  "object": "response",
                  "status": "completed",
                  "model": "MODEL_ID_FROM_CATALOGUE",
                  "output": [
                    {
                      "type": "message",
                      "role": "assistant",
                      "content": [
                        {
                          "type": "output_text",
                          "text": "Hello"
                        }
                      ]
                    }
                  ]
                }
              }
            },
            "headers": {},
            "description": "Successful response."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Responses",
        "description": "Create a response using the Responses request format. Conversation state and advanced features depend on the connected model and channel."
      }
    },
    "/v1/messages": {
      "post": {
        "deprecated": false,
        "operationId": "createMessage",
        "tags": [
          "API reference"
        ],
        "parameters": [
          {
            "name": "anthropic-version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API format version, for example 2023-06-01.",
            "example": "2023-06-01"
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "An ItaRouter-issued API key."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaudeRequest"
              },
              "example": {
                "model": "MODEL_ID_FROM_CATALOGUE",
                "max_tokens": 256,
                "messages": [
                  {
                    "role": "user",
                    "content": "Hello"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaudeResponse"
                },
                "example": {
                  "id": "msg_example",
                  "type": "message",
                  "role": "assistant",
                  "model": "MODEL_ID_FROM_CATALOGUE",
                  "content": [
                    {
                      "type": "text",
                      "text": "Hello"
                    }
                  ],
                  "stop_reason": "end_turn",
                  "usage": {
                    "input_tokens": 5,
                    "output_tokens": 1
                  }
                }
              }
            },
            "headers": {},
            "description": "Successful response."
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Messages",
        "description": "Use the Anthropic-compatible Messages request format. Supply anthropic-version and an ItaRouter API key."
      }
    },
    "/v1/embeddings": {
      "post": {
        "deprecated": false,
        "operationId": "createEmbedding",
        "tags": [
          "API reference"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbeddingRequest"
              },
              "example": {
                "model": "EMBEDDING_MODEL_ID_FROM_CATALOGUE",
                "input": "Text to embed"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingResponse"
