                "example": {
                  "object": "list",
                  "data": [
                    {
                      "object": "embedding",
                      "index": 0,
                      "embedding": [
                        0.1,
                        -0.2,
                        0.3
                      ]
                    }
                  ],
                  "model": "EMBEDDING_MODEL_ID_FROM_CATALOGUE",
                  "usage": {
                    "prompt_tokens": 3,
                    "total_tokens": 3
                  }
                }
              }
            },
            "headers": {},
            "description": "Successful response."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Embeddings",
        "description": "Convert text into vectors using an available embedding model."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "ItaRouter API key, not a browser login token."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "ItaRouter key for the Messages format."
      }
    },
